{
  "title": "TutBerry HTTP",
  "uid": "tutberry-http",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Requests/s",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "5xx ratio",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 0.001)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Booking p95",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"api/bookings\",method=\"POST\"}[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Outbox backlog",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "outbox_pending",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Oldest event age",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "outbox_oldest_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Readiness",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "service_ready",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Search p95",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(le,outcome)(rate(http_request_duration_seconds_bucket{route=\"api/listings\"}[5m])))",
          "refId": "A"
        }
      ]
    }
  ]
}
